# Copy to .env next to compose.yaml.
# The whole file is also passed into the container, where the server reads NEMO_SPEECH_* variables
# as its settings; keep other names out of that prefix.

# Backend to run: cpu, vulkan or cuda. Start only one, they share the port.
COMPOSE_PROFILES=cpu

# Host port the server is published on (always bound to 127.0.0.1).
HOST_PORT=8080

# Require "Authorization: Bearer <key>" on API routes; paste the same key into the app's
# "Server API key" field.
# NEMO_SPEECH_HTTP_API_KEY=
